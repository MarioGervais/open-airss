{
  "name": "open-airss",
  "version": "0.1.0",
  "description": "A minimalist, self-hostable RSS reader for the web.",
  "license": "AGPL-3.0",
  "private": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
